<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SAMAWA - Wedding Planning</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: white;
            padding: 2rem;
        }

        nav {
            display: flex;
            align-items: center;
            margin-bottom: 4rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.5rem;
            color: #333;
            text-decoration: none;
        }

        .logo-icon {
            font-size: 2rem;
        }

        .logo-text {
            color: #00bfa5;
            font-weight: bold;
        }

        .hero {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 4rem;

            /* updated  */
            position: relative;
            padding: 20px;
        }

        .hero-content {
            max-width: 600px;
        }

        .image-container {
            position: relative;
            max-width: 40%; 
            text-align: center;
        }
        .image-container img {
            width: 350px;
            text-align: center;
            height: auto;
            border-radius: 10px;
            /* box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);  */
        }
        .image-caption {
            position: absolute;
            bottom: 10px;
            left: 10px;
            color: #fff;
            font-size: 1.2em;
            font-weight: bold;
            background-color: rgba(0, 0, 0, 0.6); 
            padding: 5px 10px;
            border-radius: 5px;
            margin-left: 30px;
            text-align: center;
        }

        .subtitle {
            color: #00bfa5;
            margin-bottom: 1rem;
            font-size: 1.2rem;
        }

        .title {
            font-size: 3.5rem;
            line-height: 1.2;
            margin-bottom: 2rem;
            font-weight: 900;
        }

        .btn {
            background-color: #00bfa5;
            color: white;
            padding: 1rem 2rem;
            border-radius: 2rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
            transition: transform 0.2s;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .overview {
            margin-top: 3rem;
        }

        .overview-title {
            font-size: 1.5rem;
            margin-bottom: 2rem;
            text-decoration: underline;
            color: #333;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .card {
            padding: 2rem;
            border-radius: 1rem;
            background: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        .tag {
            background: #00bfa5;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 1rem;
            display: inline-block;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .card-content {
            font-size: 1.2rem;
            color: #333;
            font-weight: bold;
            padding: 10px;
        }

        .venue-details {
            color: #666;
            margin-top: 0.5rem;
            font-size: 1rem;
        }
        .no-event {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ff5e57;
            text-align: center;
        }
        .cancel-btn{
            background-color: #ff5e57;
            margin-right: 10px;
        }
        .btm-btn-container{
            display: flex;
            justify-content: flex-end; 
             margin-top: 2rem; 
             padding: 10px;
        }
        .btm-btn{
            border: none;
        }
    </style>
</head>
<body>
    <nav>
        <a href="#" class="logo">
            <span class="logo-icon">💍</span>
            <span class="logo-text">SAMAWA</span>
        </a>
    </nav>

    <main>
        <section class="hero">
            <div class="hero-content">
                <p class="subtitle">Once in a lifetime moments...</p>
                <h1 class="title">Start your journey to the perfect wedding</h1>
                <a href="form.html" class="btn">Get started <span>→</span></a>
            </div>
            <!-- Image container with overlay text -->
            <div class="image-container">
                <img src="images/heart.png" alt="Bride and Groom">
                <% if (brideName && groomName) { %>
                    <div class="image-caption"><%= brideName %> ❤️ <%= groomName %></div>
                <% } %>
            </div>
        </section>

        <section class="overview">
            <h2 class="overview-title">Overview</h2>
            <% if (hasEvent) { %>
                <div class="cards">
                    <div class="card">
                        <div class="tag">EVENT DAY</div>
                        <div class="card-content"><%= weddingDate %></div>
                        <div class="tag">GUEST COUNT</div>
                        <div class="card-content"><%= guestCount %></div>
                        <div class="tag">VENUE</div>
                        <div class="card-content"><%= venueName %>, <%= venueLocation %></div>
                    </div>
                    <div class="card">
                        <div class="tag">SERVICES</div>
                        <div class="card-content">Photography & Videography:<br> <%= photography %></div>
                        <div class="card-content">Catering:<br> <%= catering %></div>
                        <div class="card-content">Makeup & Styling:<br> <%= makeup %></div>
                    </div>
                    <div class="card">
                        <div class="tag">TOTAL BUDGET</div>
                        <div class="card-content"><%= budget %></div>
                        <div class="tag">PAYMENT STATUS</div>
                        <div class="card-content"><%= eventStatus || "Not Paid" %></div>
                        <div class="btm-btn-container">
                            <form action="/cancel-event" method="POST" onsubmit="return confirm('Are you sure you want to cancel this event?');">
                                <button type="submit" class="btn cancel-btn btm-btn">Cancel Event</button>
                            </form>
            
                            <!-- Book Event Button -->
                            <form action="/book-event" method="GET">
                                <button type="submit" class="btn btm-btn">Book Event</button>
                        
                            </form>
                        </div>
                    </div>
                    <!-- <div class="card">
                        <div class="tag">STATUS</div>
                        <div class="card-content"><%= eventStatus || "Not Paid" %></div>
                    </div> -->
                </div>
                
                <!-- Cancel Event Button -->
            
            <% } else { %>
                <div class="no-event">You don't have an event yet!</div>
            <% } %>
        </section>

        
    </main>
    <script>
           window.onload = function() {
            var audio = new Audio('music/Ritha Dhamava.mp3');
            audio.loop = true; // Set the audio to loop
            audio.play(); // Play the audio
        };
    </script>
</body>
</html>
